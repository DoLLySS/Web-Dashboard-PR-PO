# เทมเพลตการตั้งค่า (ข้อมูลด้านล่างเป็นตัวอย่างปลอมทั้งหมด)
# วิธีใช้: คัดลอกไฟล์นี้เป็น ".env" แล้วกรอกค่าจริง จากนั้นรีสตาร์ทแอป
# ห้าม commit ไฟล์ .env ขึ้น Git (ถูกกันไว้ใน .gitignore แล้ว) และห้ามส่งรหัสผ่านทางแชท/อีเมล
# บน Linux ให้ตั้งสิทธิ์ด้วย chmod 600 .env

# --- SharePoint แบบเดิม: ใช้ไม่ได้แล้ว ---
# โค้ดส่วนนี้ล็อกอินผ่าน Azure ACS ซึ่ง Microsoft ประกาศเลิกใช้กับ SharePoint Online ตั้งแต่ 2 เม.ย. 2026
# แผนใหม่คือเชื่อมผ่าน Power Automate ดู NEXT_STEPS.md

# URL ของ SharePoint Site ที่เก็บเอกสาร
SHAREPOINT_URL=https://yourcompany.sharepoint.com/sites/IT

# Client ID / Secret ของ App ที่ลงทะเบียนไว้ (ให้ผู้ดูแล SharePoint/Azure สร้างให้ และให้สิทธิ์เขียนใน Site นี้)
SHAREPOINT_CLIENT_ID=00000000-0000-0000-0000-000000000000
SHAREPOINT_CLIENT_SECRET=your-client-secret-here

# (ตัวเลือกสำรอง ยังไม่ถูกใช้) ล็อกอินด้วย Username/Password แทน Client ID/Secret
# ต้องไปเปิดโค้ดส่วน UserCredential ใน sharepoint_api.py ด้วยจึงจะใช้งานได้
SHAREPOINT_USERNAME=your.name@yourcompany.com
SHAREPOINT_PASSWORD=your-password-here

# (ไม่บังคับ) โฟลเดอร์ปลายทาง ต้องมีอยู่แล้วบน SharePoint — ถ้าไม่ใส่จะใช้ "Shared Documents/PR-PO"
SHAREPOINT_FOLDER_PATH=Shared Documents/PR-PO

# --- ตั้งค่าทั่วไป (ไม่บังคับทั้งหมด: ถ้าไม่ใส่หรือใส่ผิด ระบบใช้ค่าเริ่มต้นแทน ไม่แครช) ---
# ระดับ Log ที่บันทึกลง logs/app.log: DEBUG / INFO / WARNING / ERROR (ค่าเริ่มต้น INFO)
LOG_LEVEL=INFO
# รอฐานข้อมูลกี่วินาทีถ้าถูกล็อก ต้องเป็นจำนวนเต็มมากกว่า 0 (ค่าเริ่มต้น 10)
DB_TIMEOUT_SECONDS=10

# --- ตั้งค่าตอนรันบน Server (ดู DEPLOY.md) ---
# ที่อยู่ไฟล์ฐานข้อมูล (ไม่ใส่ = data/masterlist.db ในโปรเจค) บน Server ให้ชี้ดิสก์ในเครื่อง ไม่ใช่ OneDrive / network share
DB_FILE_PATH=
# โหมดบันทึกของ SQLite: DELETE (ค่าเริ่มต้น) หรือ WAL (รองรับผู้ใช้พร้อมกันดีกว่า ใช้เฉพาะ DB ที่อยู่ดิสก์ในเครื่อง)
DB_JOURNAL_MODE=DELETE
# 1 = กดไอคอน File แล้วคัดลอกไฟล์ไป Desktop (ใช้เฉพาะตอนรันบนเครื่องตัวเอง) / 0 = เปิดหน้าต่างรายการไฟล์ของแถว (ใช้บน Server)
LOCAL_DESKTOP_EXPORT=0

# --- ที่เก็บไฟล์ออนไลน์ ---
# เลือกปลายทาง: ตอนนี้ใช้ gdrive (ค่าเริ่มต้น ใช้ทดสอบ) ถ้าตั้งค่าไม่ครบ ระบบจะเก็บไฟล์ในเครื่องอย่างเดียว
STORAGE_BACKEND=gdrive
# Google Drive (Service Account): path ของไฟล์ JSON key (เก็บนอก Git) และ ID โฟลเดอร์ราก (แนะนำให้อยู่ใน Shared Drive)
GDRIVE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
GDRIVE_ROOT_FOLDER_ID=your-folder-id-here
# (ยังไม่มี API) URL ของ Master-List
MASTERLIST_API_URL=
