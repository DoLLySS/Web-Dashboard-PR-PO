# เทมเพลตการตั้งค่า SharePoint (ข้อมูลด้านล่างเป็นตัวอย่างปลอมทั้งหมด)
# วิธีใช้: คัดลอกไฟล์นี้เป็น ".env" แล้วกรอกค่าจริง จากนั้นรีสตาร์ทแอป
# ห้าม commit ไฟล์ .env ขึ้น Git (ถูกกันไว้ใน .gitignore แล้ว) และห้ามส่งรหัสผ่านทางแชท/อีเมล

# URL ของ SharePoint Site ที่เก็บเอกสาร
SHAREPOINT_URL=https://yourcompany.sharepoint.com/sites/IT

# Client ID / Secret ของ App ที่ลงทะเบียนไว้ (ให้ผู้ดูแล SharePoint/Azure สร้างให้ และให้สิทธิ์เขียนใน Site นี้)
SHAREPOINT_CLIENT_ID=00000000-0000-0000-0000-000000000000
SHAREPOINT_CLIENT_SECRET=your-client-secret-here

# (ตัวเลือกสำรอง ยังไม่ถูกใช้) ล็อกอินด้วย Username/Password แทน Client ID/Secret
# ต้องไปเปิดโค้ดส่วน UserCredential ใน sharepoint_api.py ด้วยจึงจะใช้งานได้
SHAREPOINT_USERNAME=your.name@yourcompany.com
SHAREPOINT_PASSWORD=your-password-here

# (ไม่บังคับ) โฟลเดอร์ปลายทาง ต้องมีอยู่แล้วบน SharePoint — ถ้าไม่ใส่จะใช้ "Shared Documents/PR-PO"
SHAREPOINT_FOLDER_PATH=Shared Documents/PR-PO

# --- ตั้งค่าทั่วไป (ไม่บังคับทั้งหมด: ถ้าไม่ใส่หรือใส่ผิด ระบบใช้ค่าเริ่มต้นแทน ไม่แครช) ---
# ระดับ Log ที่บันทึกลง logs/app.log: DEBUG / INFO / WARNING / ERROR (ค่าเริ่มต้น INFO)
LOG_LEVEL=INFO
# รอฐานข้อมูลกี่วินาทีถ้าถูกล็อก ต้องเป็นจำนวนเต็มมากกว่า 0 (ค่าเริ่มต้น 10)
DB_TIMEOUT_SECONDS=10
